/* ==========================================================================
   PRONOTE-TUI - Modern High-Definition Terminal Theme
   Palette: Deep Dark Slate, Cyber Jade, Electric Cyan, Gold Amber, Rose
   ========================================================================== */

Screen {
    background: #080c14;
    color: #e2e8f0;
}

Header {
    background: #0d1527;
    color: #38bdf8;
    dock: top;
    height: 1;
    text-style: bold;
}

Footer {
    background: #0d1527;
    color: #94a3b8;
    dock: bottom;
    height: 1;
}

Footer > .footer--highlight {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
}

Footer > .footer--key {
    background: #10b981;
    color: #022c22;
    text-style: bold;
}

/* --------------------------------------------------------------------------
   Top Profile & Statistics Banner
   -------------------------------------------------------------------------- */
#profile-banner {
    height: 4;
    background: #0d1527;
    border-bottom: heavy #10b981;
    padding: 0 2;
    layout: horizontal;
    align: center middle;
}

#student-info {
    width: 50%;
    height: 100%;
    align: left middle;
}

#student-name {
    text-style: bold;
    color: #34d399;
}

#student-meta {
    color: #94a3b8;
}

#banner-stats {
    width: 50%;
    height: 100%;
    align: right middle;
    layout: horizontal;
}

#banner-badge-status {
    padding: 0 1;
    height: 100%;
    align: center middle;
    margin-right: 1;
}

.stat-box {
    padding: 0 2;
    border-left: solid #243046;
    height: 100%;
    align: center middle;
}

/* --------------------------------------------------------------------------
   Tab Navigation & Content
   -------------------------------------------------------------------------- */
TabbedContent {
    height: 1fr;
    background: #080c14;
}

ContentTab {
    color: #94a3b8;
    background: #0d1527;
    padding: 0 3;
    border-top: solid transparent;
}

ContentTab.-active {
    color: #ffffff;
    background: #162238;
    border-top: solid #10b981;
    text-style: bold;
}

ContentTab:hover {
    color: #38bdf8;
    background: #111a2e;
}

TabPane {
    padding: 1 2;
    background: #080c14;
}

/* --------------------------------------------------------------------------
   Data Tables
   -------------------------------------------------------------------------- */
DataTable {
    background: #0d1527;
    border: round #243046;
    height: 1fr;
}

DataTable:focus {
    border: round #10b981;
}

DataTable > .datatable--header {
    background: #162238;
    color: #38bdf8;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1d4ed8;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: #10192e;
}

/* --------------------------------------------------------------------------
   Notes View
   -------------------------------------------------------------------------- */
#notes-main-layout {
    height: 1fr;
}

#subjects-col {
    width: 55%;
    height: 1fr;
}

#grades-detail-col {
    width: 45%;
    height: 1fr;
    padding-left: 1;
}

.summary-card {
    background: #0d1527;
    border: round #10b981;
    padding: 0 2;
    height: 3;
    align: center middle;
    margin-bottom: 1;
}

/* --------------------------------------------------------------------------
   Timetable View (Emploi du temps)
   -------------------------------------------------------------------------- */
#timetable-nav {
    height: 3;
    layout: horizontal;
    align: center middle;
    margin-bottom: 1;
    background: #0d1527;
    border: round #243046;
    padding: 0 1;
}

#timetable-date-label {
    width: 1fr;
    text-align: center;
    text-style: bold;
    color: #38bdf8;
}

#lessons-container {
    height: 1fr;
}

.lesson-card {
    background: #0d1527;
    border: round #243046;
    border-left: thick #10b981;
    padding: 1 2;
    margin-bottom: 1;
}

.lesson-card-maths {
    border-left: thick #38bdf8;
}

.lesson-card-nsi {
    border-left: thick #10b981;
}

.lesson-card-philo {
    border-left: thick #a855f7;
}

.lesson-card-hg {
    border-left: thick #f59e0b;
}

.lesson-card-lang {
    border-left: thick #ec4899;
}

.lesson-card-cancelled {
    background: #201115;
    border: round #4c1d24;
    border-left: thick #ef4444;
    padding: 1 2;
    margin-bottom: 1;
}

.lesson-card-modified {
    background: #241c0c;
    border: round #452a0a;
    border-left: thick #f59e0b;
    padding: 1 2;
    margin-bottom: 1;
}

/* --------------------------------------------------------------------------
   Homework View (Devoirs)
   -------------------------------------------------------------------------- */
.hw-header-row {
    height: 3;
    align: center middle;
    background: #0d1527;
    border: round #243046;
    padding: 0 2;
    margin-bottom: 1;
}

#hw-items-container {
    height: 1fr;
}

.hw-item {
    background: #0d1527;
    border: round #243046;
    padding: 1 2;
    margin-bottom: 1;
    layout: horizontal;
}

.hw-item-selected {
    background: #16243d;
    border: double #10b981;
}

.hw-done {
    border-left: thick #10b981;
    opacity: 65%;
}

.hw-todo {
    border-left: thick #f59e0b;
}

.hw-overdue {
    border-left: thick #ef4444;
}

.hw-card-text {
    width: 75%;
}

.hw-btn-toggle {
    width: 25%;
    min-width: 14;
}

/* --------------------------------------------------------------------------
   Simulator View
   -------------------------------------------------------------------------- */
.sim-container {
    background: #080c14;
    height: 1fr;
}

.sim-section-card {
    background: #0d1527;
    border: round #243046;
    padding: 1 2;
    margin-bottom: 1;
}

.sim-section-card:focus-within {
    border: round #38bdf8;
}

.sim-row {
    height: 4;
    align: center middle;
}

.sim-col-40 {
    width: 40%;
}

.sim-col-25 {
    width: 25%;
    padding-left: 1;
}

.sim-col-20 {
    width: 20%;
    padding-left: 1;
}

.sim-col-15 {
    width: 15%;
    padding-left: 1;
}

.sim-result-card {
    background: #070d18;
    border: round #10b981;
    padding: 1 2;
    margin-top: 1;
}

/* --------------------------------------------------------------------------
   Vie Scolaire View
   -------------------------------------------------------------------------- */
.vie-kpi-row {
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
}

.vie-kpi-card {
    width: 25%;
    height: 100%;
    background: #0d1527;
    border: round #243046;
    align: center middle;
    margin-right: 1;
}

.vie-layout {
    height: 1fr;
}

.vie-col-left {
    width: 50%;
    padding-right: 1;
    height: 1fr;
}

.vie-col-right {
    width: 50%;
    padding-left: 1;
    height: 1fr;
}

/* --------------------------------------------------------------------------
   Modals (Login & Help)
   -------------------------------------------------------------------------- */
#login-dialog {
    width: 86;
    max-height: 94%;
    background: #0d1527;
    border: double #10b981;
    padding: 1 2;
    overflow-y: auto;
}

.papillon-banner {
    background: #0f172a;
    border-left: thick #38bdf8;
    padding: 1;
    margin-bottom: 1;
}

.search-box-row {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
}

#city-search-input {
    width: 1fr;
    margin-right: 1;
}

#btn-search-city {
    width: auto;
}

.school-selected-badge {
    background: #042f2e;
    border: round #10b981;
    padding: 1;
    margin-top: 1;
    margin-bottom: 1;
}

.web-action-row {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
}

#btn-open-web {
    width: 1fr;
    margin-right: 1;
}

#login-title {
    text-align: center;
    text-style: bold;
    color: #34d399;
}

#login-error-msg {
    color: #f43f5e;
    margin-top: 1;
    text-align: center;
}

.modal-btn-row {
    height: 3;
    align: center middle;
    margin-top: 1;
}

#help-dialog {
    width: 82;
    max-height: 92%;
    background: #0d1527;
    border: double #38bdf8;
    padding: 1 2;
}

.empty-msg {
    padding: 3;
    text-align: center;
}
